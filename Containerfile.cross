# Cross-compile builder image: native x86_64 toolchain that targets aarch64
# via Debian multiarch :arm64 dev packages. This avoids qemu-user emulation
# entirely — the compiler, cmake, ninja, and cpack all run native amd64 — but
# produces arm64 .debs.
#
# STATUSBAR_TOOLCHAIN selects how the cross-targeting is done:
#   clang (default) — one clang binary with --target=aarch64-linux-gnu.
#   gcc             — Debian's g++-16-aarch64-linux-gnu cross compiler, since
#                     GCC has no multi-target driver. Needs a base that ships
#                     it (forky+); the build script defaults DEBIAN_VERSION
#                     accordingly.
#
# Companion to the emulated Containerfile. Used by scripts/container-build-cross.sh.

ARG DEBIAN_VERSION=trixie
ARG TARGET_ARCH=arm64
ARG STATUSBAR_TOOLCHAIN=clang

# Pin host platform to amd64 — the whole point of this image is to run a
# native amd64 toolchain that cross-targets aarch64. Without this, podman
# may reuse a cached arm64 manifest of debian:<version> (e.g. left over
# from the emulated builder), silently turning the build into qemu.
FROM --platform=linux/amd64 debian:${DEBIAN_VERSION}
ARG TARGET_ARCH
ARG STATUSBAR_TOOLCHAIN

RUN dpkg --add-architecture "${TARGET_ARCH}" \
 && apt-get update && apt-get install -y --no-install-recommends \
      clang clang-tools lld \
      cmake ninja-build ccache pkg-config \
      dpkg-dev file ca-certificates \
      python3 python3-jsonschema \
      libc++-dev:${TARGET_ARCH} \
      libc++abi-dev:${TARGET_ARCH} \
      libclang-rt-dev:${TARGET_ARCH} \
      libasound2-dev:${TARGET_ARCH} \
      libbpf-dev:${TARGET_ARCH} \
      libxdp-dev:${TARGET_ARCH} \
      libelf-dev:${TARGET_ARCH} \
      zlib1g-dev:${TARGET_ARCH} \
      libasound2t64 libbpf1 libxdp1 \
 && if [ "$STATUSBAR_TOOLCHAIN" = "gcc" ]; then \
      apt-get install -y --no-install-recommends \
        g++-16-aarch64-linux-gnu libstdc++-16-dev-arm64-cross ; \
    fi \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /opt/cross-tools \
 && SD="$(command -v clang-scan-deps \
          || ls -1 /usr/bin/clang-scan-deps-* /usr/lib/llvm-*/bin/clang-scan-deps \
               2>/dev/null | sort -V | tail -1)" \
 && cp "$SD" /opt/cross-tools/clang-scan-deps \
 && printf '%s\n' "$SD" > /opt/cross-tools/clang-scan-deps.path

WORKDIR /build
